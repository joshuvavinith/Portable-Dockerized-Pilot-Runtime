# Example configuration for a SECOND compatible Docker host.
# Use with:  docker compose --env-file .env.second-host.example ...
# Differences from the dev template are configuration only: scope, paths,
# project name (separate DB volume) and credentials.

COMPOSE_PROJECT_NAME=iris-host2

IRIS_COUNTRY_CODE=NL
IRIS_REGION_CODE=LI

IRIS_SOURCE_ENDPOINT=fixture://sites.geojson
# Remote GeoJSON example (no credentials in the URL; they are redacted anyway):
# IRIS_SOURCE_ENDPOINT=https://data.example.org/iris/sites.geojson

IRIS_OUTPUT_PATH=/data/iris-output
# Different host directory (must exist and be writable by IRIS_UID), e.g.:
#   sudo install -d -o "$(id -u)" -g "$(id -g)" /srv/iris/output
IRIS_OUTPUT_HOST_DIR=./output
# IRIS_OUTPUT_HOST_DIR=/srv/iris/output

# Run `id -u` / `id -g` on this host.
IRIS_UID=1000
IRIS_GID=1000

POSTGRES_DB=iris_nl
POSTGRES_USER=iris
# Intentionally EMPTY: compose refuses to start until you provide one.
#   export POSTGRES_PASSWORD="$(openssl rand -hex 16)"
POSTGRES_PASSWORD=change_me

POSTGRES_PUBLISH_PORT=5433
