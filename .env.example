# Dev configuration. Copy to .env:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.

COMPOSE_PROJECT_NAME=iris-dev

# --- scope (change these to run another country/region; no code edits) ---
IRIS_COUNTRY_CODE=DE
IRIS_REGION_CODE=NW

# --- source: fixture://<file in ./fixtures> or http(s)://... GeoJSON ---
IRIS_SOURCE_ENDPOINT=fixture://sites.geojson

# --- output ---
# IRIS_OUTPUT_PATH        absolute path INSIDE the container
# IRIS_OUTPUT_HOST_DIR    directory on the host that is mounted there (must exist)
IRIS_OUTPUT_PATH=/app/output
IRIS_OUTPUT_HOST_DIR=./output

# Host user, so the output directory is writable. Linux: run `id -u` / `id -g`.
IRIS_UID=1000
IRIS_GID=1000

# --- database (local dev password only; use a generated one anywhere shared) ---
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris_dev_only_change_me

# --- optional ---
# POSTGIS_IMAGE=postgis/postgis:16-3.4
# POSTGRES_PUBLISH_PORT=5433        # publish the DB on 127.0.0.1:5433 (default: random port)
# IRIS_AREA_TOLERANCE_PCT=5
# IRIS_LOG_LEVEL=INFO
